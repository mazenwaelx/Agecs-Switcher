{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AGECS: Run (auto-switch accounts)",
      "detail": "Launch Claude in the terminal and auto-switch accounts when a limit hits",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/agecs.mjs", "run", "claude"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "AGECS: Watch (extension panel)",
      "detail": "Use the Claude Code SIDEBAR panel; auto-switches the account on a limit",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/agecs.mjs", "watch", "claude"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "AGECS: Log in an account",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/agecs.mjs", "login", "${input:accountName}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "AGECS: Status",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/agecs.mjs", "status"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "AGECS: Doctor (check accounts)",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/agecs.mjs", "doctor"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "AGECS: App",
      "detail": "Open the AGECS Switcher as a desktop app window",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/app.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "AGECS: Control panel (web)",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/server.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "AGECS: Run tests",
      "type": "shell",
      "command": "node",
      "args": ["--test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    { "id": "accountName", "type": "promptString", "description": "Account name (e.g. claude-1, claude-2)" }
  ]
}
